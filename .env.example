DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/tracuu?schema=public"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tracuu
NEXT_PUBLIC_APP_URL=http://localhost:3000   # domain thật dùng để tạo link trong mã QR
ADMIN_PASSWORD=                              # tùy chọn: bảo vệ /admin và các API ghi
