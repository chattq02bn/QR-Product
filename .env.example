# Local: trùng DATABASE_URL. Neon (production):
#   DATABASE_URL         = connection string dạng "Pooled" (ep-xxx-pooler...)
#   DIRECT_DATABASE_URL  = connection string dạng "Direct"  (ep-xxx...) - dùng cho migrate
