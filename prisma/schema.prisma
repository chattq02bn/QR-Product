generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  /// Mã sản phẩm (in trên bao bì / báo giá). Bắt buộc, duy nhất: mỗi mã ứng với đúng 1 QR.
  productCode  String         @unique
  /// Ảnh sản phẩm (upload lên Cloudinary hoặc chèn link ngoài). null = chưa có.
  imageUrl     String?
  /// Mô tả sản phẩm, tối đa 500 từ.
  description  String?        @db.Text
  /// Nhà sản xuất.
  manufacturer String?
  /// Thông số kỹ thuật (JSON dạng [{ "label": "Tên sản phẩm", "value": "..." }]).
  specs        Json?
  /// Nhà sản xuất / Đơn vị phân phối (JSON dạng [{ "label": "Tên đơn vị", "value": "..." }]).
  distributor  Json?
  /// Thời điểm hết hạn mã QR. null = dùng vĩnh viễn.
  qrExpiresAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  images       ProductImage[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  publicId  String
  order     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
